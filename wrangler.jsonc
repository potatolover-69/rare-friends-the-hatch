{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rare-friends-the-hatch",
  "compatibility_date": "2026-09-26",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run build"
  }
}
