{
  "name": "rare-friends-the-hatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "postinstall": "npm run build --prefix node_modules/@rarefriends/friendsdk",
    "build": "node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs build game --outdir dist",
    "check": "node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs check game",
    "test:game": "node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs test game --width 960",
    "dev": "node node_modules/@rarefriends/friendsdk/scripts/dev-game.mjs dev game --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@rarefriends/friendsdk": "github:spokesz/friendsdk#main",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "6.0.3",
    "wrangler": "^4.41.0"
  }
}
